// Windows version resource (generated by CMake from version.rc.in)
// REAPER shows FileDescription in Preferences > Plug-ins > Extensions
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "4irmann"
      VALUE "FileDescription", "4irmann's FaderPort Driver - PreSonus FaderPort (classic) control surface"
      VALUE "FileVersion", "@FADERPORT_VERSION_STRING@"
      VALUE "InternalName", "reaper_4irmann_faderport"
      VALUE "LegalCopyright", "Copyright 2010-2026 Matthias Ehrmann, Apache License 2.0"
      VALUE "OriginalFilename", "reaper_4irmann_faderport.dll"
      VALUE "ProductName", "4irmann's FaderPort Driver for REAPER"
      VALUE "ProductVersion", "@FADERPORT_VERSION_STRING@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
